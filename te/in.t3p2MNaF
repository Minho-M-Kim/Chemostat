units           real
atom_style      full
boundary        p p p
dielectric      1
special_bonds   lj/coul 0.0 0.0 0.5 

pair_style      lj/charmm/coul/long/opt 13 14.00000 
bond_style      harmonic  
angle_style     harmonic  
dihedral_style  none    
improper_style  none
kspace_style    pppm 0.001   

read_restart    t3p2MNaF.avg.1000000.restart

pair_coeff 1 1 0.0000 0.0000 
pair_coeff 1 2 0.0000 0.0000
pair_coeff 1 3 0.0000 0.0000
pair_coeff 1 4 0.0000 0.0000
pair_coeff 2 2 0.1020 3.1880 #t3pe
pair_coeff 2 3 0.1010 2.8855 #t3pe~Na+ (Netz)
pair_coeff 2 4 0.0191 3.6745 #t3pe~F- (Netz)
pair_coeff 3 3 0.1000 2.5830 #Na+ (Netz)
pair_coeff 3 4 0.0284 3.3720 #Na+_F- scale1.5 (Netz)
pair_coeff 4 4 0.0036 4.1610 #F- (Netz)
 

neighbor        2.0 multi
neigh_modify    every 2 delay 4 check yes
thermo_style    multi

variable        input index in.t3p2MNaF
variable        sname index t3p2MNaF

fix             1 all momentum 1 linear 1 1 1 angular
fix             shakeH all shake 0.0001 20 500 b 1 a 1
thermo          100
timestep	1.0
#thermo_style    custom temp etotal ke pe ebond eangle evdwl ecoul elong press lz density 
#thermo_modify   line multi

print                          .
print =====================================
print "NVT dynamics for MOBILE"
print =====================================
print            .

region          11 block 0.0 10.0000 0.0 10.0000 5.86888 30.000 
#region          11 block 0.0 45.6799 0.0 46.8859 5.86888 32.956 

reset_timestep  0
dump            2 all custom 1000 ${sname}.avg.lammpstrj id type xu yu zu
restart         500000 ${sname}.avg.*.restart
fix             5 all conc/berendsen 1.0 1.0 100.0 11
#compute         5_conc all conc 11
thermo_style    custom temp etotal ke pe ebond eangle evdwl ecoul elong press lz density c_5_conc[1] c_5_conc[2] c_5_conc[3] c_5_conc[4]
thermo_modify   line multi
#fix             3 all nvt temp 300.0 300.0 100.0 
run             1000000
unfix           3
undump          2

