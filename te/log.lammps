units           real
atom_style      full
boundary        p p p
dielectric      1
special_bonds   lj/coul 0.0 0.0 0.5

pair_style      lj/charmm/coul/long/opt 13 14.00000
bond_style      harmonic
angle_style     harmonic
dihedral_style  none
improper_style  none
kspace_style    pppm 0.001

read_restart    t3p2MNaF.avg.1000000.restart
